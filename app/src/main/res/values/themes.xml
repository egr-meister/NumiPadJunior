<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NumiPad" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Launch screen: same identity, dismissed as soon as the first frame draws. -->
    <style name="Theme.NumiPad.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NumiPad</item>
    </style>
</resources>
